# Point the dashboard at the Ubuntu backend. For a Windows browser viewing a
# VM backend, use the Ubuntu host-only IP, e.g.:
#   VITE_BACKEND_URL=http://192.168.56.10:8000
#   VITE_WS_URL=ws://192.168.56.10:8000/ws/live
# Defaults below assume the browser and backend are on the same host.
VITE_BACKEND_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
