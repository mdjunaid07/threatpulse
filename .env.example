# =====================================================================
# .env.example  —  copy to .env and fill in for YOUR machine:
#     cp .env.example .env
#
# Every variable overrides the matching default in configs/config.yaml.
# Blank values fall back to the config default. Fields marked OPTIONAL
# can be left blank. NEVER commit your real .env.
# =====================================================================

# ---------- APPLICATION ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- MODE ----------
# live | replay | hybrid
SYSTEM_MODE=replay
REPLAY_ENABLED=true

# ---------- LAB (fill in from `ip addr` on each VM; OPTIONAL for replay) ----------
KALI_IP=
UBUNTU_IP=
MONITOR_INTERFACE=
VICTIM_INTERFACE=

# ---------- REDIS (OPTIONAL: if unreachable, an in-memory bus is used) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- MODEL ----------
MODEL_PATH=models/lstm_world_model.pt
SCALER_PATH=models/scaler.pkl
SEQUENCE_LENGTH=10
FORECAST_HORIZON=4
WINDOW_SECONDS=10
MODEL_DEVICE=cpu

# ---------- FRONTEND ----------
FRONTEND_ORIGIN=http://localhost:5173

# ---------- ZEEK (live mode) ----------
ZEEK_ENABLED=true
ZEEK_LOG_DIR=/opt/zeek/logs/current

# ---------- SURICATA (live mode) ----------
SURICATA_ENABLED=true
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# ---------- TRAINING (OPTIONAL) ----------
# Leave DATASET_PATH blank to train on the built-in synthetic generator.
DATASET_PATH=

# ---------- SECURITY (OPTIONAL) ----------
# If API_KEY is set, REST endpoints require header  X-API-Key: <value>
API_KEY=
